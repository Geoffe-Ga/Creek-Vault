# ============================================================
# CREEK-VAULT REPO IGNORES
# ============================================================
# This repository is the *tool* (creek-tools) plus canonical
# reference material (ontology spec, schema-skill templates,
# vault scaffold templates, plans). The user's vault — fragments,
# threads, eddies, journal, voice — lives elsewhere on disk,
# scaffolded by `creek init --vault <path>`. The vault is NEVER
# checked into this repo. See FEAT-019.
# ============================================================

# Per-vault content directories must never be tracked even if a
# user accidentally creates them at the repo root.
/00-Creek-Meta/
/01-Fragments/
/02-Threads/
/03-Eddies/
/04-Praxis/
/05-Wavelength/
/06-Frequencies/
/07-Voice/
/08-Decisions/
/09-Reference/
/10-Liminal/
/creek-skills/

# Obsidian local state (if a user opens the repo in Obsidian).
.obsidian/workspace.json
.obsidian/cache

# Issue plans are author-private; the directory exists per-package.
**/git-issues/

# Background-agent worktrees (Claude Code harness isolation directory).
.claude/worktrees/

# Harness runtime lock (live PID/session; never source).
.claude/scheduled_tasks.lock

# ============================================================
# DEVELOPMENT ARTIFACTS
# ============================================================

# Python
**/__pycache__/
**/.venv/
**/venv/
**/virtualenv/
**/*.py[cod]
**/*.egg-info/
**/dist/
**/build/
**/*.egg
**/.eggs/
**/htmlcov/
**/.coverage
**/.coverage.*
**/coverage.xml
**/reports/

# Secrets & credentials
**/.env
**/.env.*
**/*.pem
**/credentials.json
**/token.json
**/.secrets.baseline

# OS & IDE
**/.DS_Store
**/Thumbs.db
**/.idea/
**/.vscode/
**/*.swp
**/*.swo

# Claude Code local worktrees
.claude/worktrees/

# graphify knowledge graph — machine-local artifacts only
# (graph.json, GRAPH_REPORT.md, manifest.json and cache/ast are committed;
#  stat-index.json embeds absolute paths and is rebuilt per machine)
graphify-out/cache/stat-index.json
graphify-out/graph.html
