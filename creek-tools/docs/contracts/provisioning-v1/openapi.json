{
  "openapi": "3.1.0",
  "info": {
    "title": "Creek Provisioning Control Plane",
    "version": "1.0.0",
    "description": "Authenticated asynchronous job API for one isolated vault allocation per consumer."
  },
  "security": [
    {
      "consumerBearer": []
    }
  ],
  "paths": {
    "/control/v1/activations": {
      "post": {
        "operationId": "submitActivation",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ActivationRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Durable job accepted or returned idempotently",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/control/v1/jobs/{job_id}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/JobId"
        }
      ],
      "get": {
        "operationId": "getJob",
        "responses": {
          "200": {
            "description": "Consumer-owned job state",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          }
        }
      },
      "delete": {
        "operationId": "deleteAllocation",
        "responses": {
          "202": {
            "description": "Idempotent provider teardown queued",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/control/v1/jobs/{job_id}/retry": {
      "parameters": [
        {
          "$ref": "#/components/parameters/JobId"
        }
      ],
      "post": {
        "operationId": "retryJob",
        "responses": {
          "202": {
            "description": "Retryable operation returned to the durable queue",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "consumerBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "parameters": {
      "JobId": {
        "name": "job_id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "responses": {
      "Error": {
        "description": "Bounded machine-readable refusal",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    },
    "schemas": {
      "ActivationRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "activation_id",
          "consumer_identity"
        ],
        "properties": {
          "activation_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "consumer_identity": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        }
      },
      "Job": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "job_id",
          "activation_id",
          "state",
          "attempts",
          "retryable",
          "failure_reason",
          "created_at",
          "updated_at",
          "status_url"
        ],
        "properties": {
          "job_id": {
            "type": "string",
            "format": "uuid"
          },
          "activation_id": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": [
              "pending",
              "provisioning",
              "awaiting_key_ceremony",
              "ready",
              "failed",
              "deleting",
              "deleted"
            ]
          },
          "attempts": {
            "type": "integer",
            "minimum": 0
          },
          "retryable": {
            "type": "boolean"
          },
          "failure_reason": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "provider_unavailable",
              "provider_rejected",
              "handoff_failed",
              "internal_error",
              null
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "status_url": {
            "type": "string"
          }
        }
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "message",
          "request_id"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "request_id": {
            "type": "string"
          }
        }
      }
    }
  }
}
